APP_NAME=Cuidado con Rikochet - Retail Data Platform
APP_VERSION=0.1.0
APP_ENV=development

# =============================================================================
# Origen (retail-operations-simulator)
# =============================================================================
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5434
SOURCE_POSTGRES_DB=retail_operations
SOURCE_POSTGRES_USER=retail_user
SOURCE_POSTGRES_PASSWORD=retail_password

SOURCE_DATABASE_URL=postgresql+psycopg://retail_user:retail_password@localhost:5434/retail_operations

# =============================================================================
# Destino (retail-data-platform)
# =============================================================================
TARGET_POSTGRES_HOST=localhost
TARGET_POSTGRES_PORT=5435
TARGET_POSTGRES_DB=retail_analytics
TARGET_POSTGRES_USER=analytics_user
TARGET_POSTGRES_PASSWORD=analytics_password

TARGET_DATABASE_URL=postgresql+psycopg://analytics_user:analytics_password@localhost:5435/retail_analytics